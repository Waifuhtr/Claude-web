#!/bin/sh
# git icin github.com kimlik bilgisi yardimcisi: git push/pull/clone, GitHub
# MCP'nin kullandigi token'i kullanir (GH_TOKEN, GITHUB_TOKEN ya da
# `gh auth login` ile kaydedilmis giris). Token yoksa hicbir sey yazmaz; git
# bir sonraki yontemi dener.
[ "$1" = "get" ] || exit 0
# git istegin ayrintilarini stdin'den yollar; okunup atlanir.
cat >/dev/null
token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
if [ -z "$token" ] && command -v gh >/dev/null 2>&1; then
  token="$(gh auth token --hostname github.com 2>/dev/null || true)"
fi
[ -n "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
