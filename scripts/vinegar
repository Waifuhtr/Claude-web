#!/bin/sh
# Vinegar'i (Roblox Studio'yu Wine ile calistiran baslatici) Agent Web
# ortamina uygun ayarlarla calistirir. Gercek ikili: /usr/lib/vinegar/vinegar.
#   vinegar            Studio'yu acar (gerekirse once Wine ve Studio'yu indirir)
#   vinegar manage     Vinegar ayarlari penceresi
. /app/scripts/roblox-env.sh

REAL="${VINEGAR_BIN:-/usr/lib/vinegar/vinegar}"
DATA="$XDG_DATA_HOME/vinegar"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/vinegar"

# Veri klasoru onceden varsa Vinegar "hos geldin" penceresini atlar.
mkdir -p "$DATA" "$XDG_CACHE_HOME" "$ROBLOX_STATE_DIR" "$CONFIG"

# Konteynerde Discord ve GameMode yok; ilk calismada kapatilir. Sonradan
# Vinegar ayarlarindan degistirilebilir (ayar dosyasi kalici HOME'dadir).
if [ ! -f "$CONFIG/config.toml" ]; then
  cat >"$CONFIG/config.toml" <<'EOF'
# Agent Web tarafindan olusturuldu; Vinegar ayarlarindan degistirebilirsiniz.
[studio]
discord_rpc = false
gamemode = false
EOF
fi

# Vinegar kapanirken Studio ayarlarini ve Roblox girisini settings.reg'e
# yedekler, yeni bir Wine prefix'i kurarken de geri yukler. Yerel disk her
# yeniden baslatmada silindigi icin yedek kalici HOME'da tutulur.
if [ ! -f "$DATA/settings.reg" ] && [ -f "$ROBLOX_STATE_DIR/settings.reg" ]; then
  cp "$ROBLOX_STATE_DIR/settings.reg" "$DATA/settings.reg"
fi

"$REAL" "$@" &
child=$!
trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
status=0
wait "$child" || status=$?
# A trapped signal interrupts wait; keep waiting until Vinegar really exits.
while kill -0 "$child" 2>/dev/null; do
  wait "$child" || status=$?
done

if [ -f "$DATA/settings.reg" ]; then
  if [ ! -f "$ROBLOX_STATE_DIR/settings.reg" ] || [ "$DATA/settings.reg" -nt "$ROBLOX_STATE_DIR/settings.reg" ]; then
    cp "$DATA/settings.reg" "$ROBLOX_STATE_DIR/settings.reg.tmp" &&
      mv "$ROBLOX_STATE_DIR/settings.reg.tmp" "$ROBLOX_STATE_DIR/settings.reg"
  fi
fi
exit "$status"
