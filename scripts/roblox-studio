#!/bin/sh
# Roblox Studio'yu sanal ekranda (Agent Web > Ekran sekmesi) Vinegar ile acar.
#   roblox-studio                    arka planda baslatir, gunlugu dosyaya yazar
#   roblox-studio --foreground       on planda calisir (Studio kapanana kadar)
#   roblox-studio dosya.rbxl         bir yer (place) dosyasini acar
# Diger argumanlar Studio'ya gecer; mutlak Linux yollari Wine yoluna cevrilir.
. /app/scripts/roblox-env.sh

LOG_DIR="${TMPDIR:-/tmp}/agentweb-logs"
LOG="$LOG_DIR/roblox_studio.log"
mkdir -p "$LOG_DIR"

display_num="${DISPLAY#*:}"
display_num="${display_num%%.*}"
if [ ! -S "/tmp/.X11-unix/X$display_num" ]; then
  echo "Sanal ekran ($DISPLAY) calismiyor. Agent Web'de Ekran sekmesini acin; ekran orada baslatilir." >&2
  exit 1
fi

foreground=0
if [ "${1:-}" = "--foreground" ]; then
  foreground=1
  shift
fi

# Tek bir dosya verilirse Studio'nun dosya acma komutuna cevir.
if [ $# -eq 1 ] && [ -f "$1" ]; then
  file=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
  set -- --task EditFile --localPlaceFile "$file"
fi

n=$#
for arg in "$@"; do
  case "$arg" in
    /*)
      if [ -e "$arg" ] || [ -d "$(dirname "$arg")" ]; then
        arg=$(roblox_winpath "$arg")
      fi
      ;;
  esac
  set -- "$@" "$arg"
done
shift "$n"

if [ "$foreground" = 1 ]; then
  exec vinegar run "$@"
fi

nohup vinegar run "$@" >>"$LOG" 2>&1 &
echo "Roblox Studio baslatiliyor; Agent Web'deki Ekran sekmesinden izleyebilirsiniz."
echo "Ilk acilista Wine ve Studio indirilir, birkac dakika surebilir. Gunluk: $LOG"
